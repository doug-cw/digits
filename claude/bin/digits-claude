#!/bin/sh
# Start Claude Code in a Digits environment.
#
# Run it instead of `claude` inside one of the ten environment folders (or any
# folder below one). It names the session after the environment, for example
# `left-pinky`, so chats can find and message each other with Claude Code's own
# session tools, and it loads the Digits plugin from DIGITS_PLUGIN_DIR when that
# is set. Any arguments are passed on to `claude` unchanged (for example
# `--continue`). Outside an environment it starts `claude` without a name.
#
#   DIGITS_PLUGIN_DIR  plugin folder to load with --plugin-dir (for example a
#                      checkout's plugin/); unset: rely on an installed plugin
#   AI_AGENTS_ROOT     folder holding the environments (default: $HOME); an
#                      existing absolute path after expanding a leading ~ or
#                      ~/ (not ~user), without backslashes or control characters
#   DIGITS_CLAUDE      the Claude Code command to run (default: claude)

if [ -n "${AI_AGENTS_ROOT:-}" ]; then
    case "$AI_AGENTS_ROOT" in
        *[[:cntrl:]]* | *\\*)
            echo "digits-claude: AI_AGENTS_ROOT must not contain a backslash or control characters" >&2
            exit 1
            ;;
    esac
    setting=$AI_AGENTS_ROOT
    case "$setting" in
        "~" | "~/"*) setting=$HOME${setting#"~"} ;;
    esac
    case "$setting" in
        /*) ;;
        *)
            echo "digits-claude: AI_AGENTS_ROOT must be an absolute path, not '$AI_AGENTS_ROOT'" >&2
            exit 1
            ;;
    esac
    if [ ! -d "$setting" ]; then
        echo "digits-claude: AI_AGENTS_ROOT is not an existing directory: $setting" >&2
        exit 1
    fi
    root=$(cd "$setting" && pwd -P) || root=
else
    root=$(cd "$HOME" 2>/dev/null && pwd -P) || root=
fi
here=$(pwd -P)
environment=
if [ -n "$root" ]; then
    case "$here/" in
        "$root"/?*/)
            rest=${here#"$root"/}
            environment=${rest%%/*}
            ;;
    esac
fi

case "$environment" in
    left_pinky | left_ring | left_middle | left_pointer | left_thumb | \
    right_thumb | right_pointer | right_middle | right_ring | right_pinky)
        set -- -n "$(printf '%s' "$environment" | tr '_' '-')" "$@"
        ;;
esac

if [ -n "${DIGITS_PLUGIN_DIR:-}" ]; then
    if [ ! -f "$DIGITS_PLUGIN_DIR/.claude-plugin/plugin.json" ]; then
        echo "digits-claude: no Claude plugin manifest in DIGITS_PLUGIN_DIR=$DIGITS_PLUGIN_DIR" >&2
        exit 1
    fi
    set -- --plugin-dir "$DIGITS_PLUGIN_DIR" "$@"
fi

exec "${DIGITS_CLAUDE:-claude}" "$@"

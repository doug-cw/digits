#!/usr/bin/env python3
"""Start or reattach the ai-agents tmux workbench.

One tmux session, ``ai-agents``, holds ten windows, one per independent
environment directory under your home. The launcher creates missing windows,
refuses to touch anything it does not recognise, applies the dashboard
configuration and attaches. It also implements the dashboard shortcuts for
jumping to the next chat needing attention and opening a chat's newest
session Markdown, and restarts idle Claude Code chats so they pick up a
changed shell profile or plugin.
"""

import argparse
import fcntl
import os
import re
import shutil
import stat
import subprocess
import sys
import time
from pathlib import Path

SESSION = "ai-agents"
TARGET = "=ai-agents:"
MARKER = "@ai-agents-managed"

_DIRECTORIES = (
    "left_pinky",
    "left_ring",
    "left_middle",
    "left_pointer",
    "left_thumb",
    "right_thumb",
    "right_pointer",
    "right_middle",
    "right_ring",
    "right_pinky",
)

# (index, directory under HOME, window name)
WINDOWS = tuple(
    (index, directory, directory.replace("_", " ").title())
    for index, directory in enumerate(_DIRECTORIES, start=1)
)

ATTENTION_TIERS = ("NEEDS YOU", "QUESTION", "YOUR TURN")
SESSION_OPTIONS = (
    ("base-index", "1"),
    ("destroy-unattached", "off"),
    ("renumber-windows", "off"),
    ("mouse", "on"),
)

# Replaceable hooks; every function reads them at call time.
HOME = Path.home()
CONFIG = HOME / ".tmux" / "ai-agents.conf"
TMUX = shutil.which("tmux") or "tmux"
FISH = shutil.which("fish")
# Claude Code's configuration folder; None means <HOME>/.claude.
CLAUDE_CONFIG_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or None
# The command typed into a pane to start a chat (see claude/bin/digits-claude).
CHAT_COMMAND = "digits-claude"
# Claude Code drops an Enter that arrives together with typed text.
KEY_PAUSE = 1.0
# Time for a freshly exec'd login shell to read its profile.
SHELL_PAUSE = 2.0
# Pause after one chat starts before restarting the next.
SETTLE = 5.0
EXIT_TIMEOUT = 30.0
# How long a new chat must keep running to count as started.
CONFIRM = 3.0
START_TIMEOUT = 30.0
POLL = 0.25
# Replaceable resource gate: a function returning (ok, detail), or None for
# the default memory and load check.
RESOURCE_CHECK = None
# Used when fish is absent: the login shell from $SHELL, if it is an absolute
# path to an executable file.
LOGIN_SHELL = os.environ.get("SHELL") or None


class LauncherError(Exception):
    """A failure reported as one ``ai-agents: <detail>`` line."""


def _run_tmux(args):
    return subprocess.run(
        [TMUX, *args],
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
    )


def tmux(*args):
    """Run one tmux command and return its stripped stdout; fail on error."""
    result = _run_tmux(args)
    if result.returncode != 0:
        detail = result.stderr.strip() or "tmux {} failed with status {}".format(
            args[0] if args else "", result.returncode
        )
        raise LauncherError(detail)
    return result.stdout.strip()


def list_sessions():
    """Return the names of the server's sessions (empty when no server runs)."""
    result = _run_tmux(("list-sessions", "-F", "#{session_name}"))
    if result.returncode != 0:
        if "no server running" in result.stderr or "No such file" in result.stderr:
            return []
        raise LauncherError(result.stderr.strip() or "tmux list-sessions failed")
    return [line for line in result.stdout.splitlines() if line]


def lock_path():
    return Path(HOME) / "Library" / "Caches" / "env-sync" / "ai-agents.lock"


def environment_shell():
    """fish when installed, else the user's login shell; None when neither."""
    if FISH:
        return FISH
    shell = LOGIN_SHELL
    if shell and os.path.isabs(shell) and os.path.isfile(shell) and os.access(shell, os.X_OK):
        return shell
    return None


def _shell_command():
    return ["/usr/bin/env", "-u", "VIRTUAL_ENV", str(environment_shell()), "-l"]


def _require_managed():
    if tmux("show-options", "-qv", "-t", TARGET, MARKER) != "1":
        raise LauncherError(
            "session {} is unmanaged (no {} 1); it will not be modified".format(
                SESSION, MARKER
            )
        )


def ensure_session():
    """Create the session or its missing windows; never disturb existing ones."""
    config = Path(CONFIG)
    if not config.is_file():
        raise LauncherError("Missing session configuration: {}".format(config))

    new = SESSION not in list_sessions()
    existing = {}
    if not new:
        _require_managed()
        listing = tmux("list-windows", "-t", TARGET, "-F", "#{window_index}\t#{window_name}")
        for line in listing.splitlines():
            index, _, name = line.partition("\t")
            existing[int(index)] = name

    expected = {index: name for index, _directory, name in WINDOWS}
    for index in sorted(existing):
        if expected.get(index) != existing[index]:
            raise LauncherError(
                "Unexpected window {}{} named {!r}; refusing to replace it".format(
                    TARGET, index, existing[index]
                )
            )

    missing = [window for window in WINDOWS if window[0] not in existing]
    for _index, directory, _name in missing:
        path = Path(HOME) / directory
        if path.is_symlink() or not path.is_dir():
            raise LauncherError("Missing independent environment: {}".format(path))
    if missing and not environment_shell():
        raise LauncherError(
            "A login shell is required to create environment shells; install fish or set SHELL"
        )

    command = _shell_command()
    remaining = missing
    first_window = None
    if new:
        _index, directory, name = missing[0]
        first_window = tmux(
            "new-session", "-d", "-s", SESSION, "-n", name,
            "-c", str(Path(HOME) / directory), "-P", "-F", "#{window_id}", *command
        )
        tmux("set-option", "-t", TARGET, MARKER, "1")
        remaining = missing[1:]

    for option, value in SESSION_OPTIONS:
        tmux("set-option", "-t", TARGET, option, value)

    if new and tmux("display-message", "-p", "-t", first_window, "#{window_index}") != "1":
        tmux("move-window", "-s", first_window, "-t", "{}1".format(TARGET))

    for index, directory, name in remaining:
        tmux(
            "new-window", "-d", "-t", "{}{}".format(TARGET, index), "-n", name,
            "-c", str(Path(HOME) / directory), *command
        )

    for index, _directory, _name in WINDOWS:
        window = "{}{}".format(TARGET, index)
        tmux("set-option", "-w", "-t", window, "automatic-rename", "off")
        tmux("set-option", "-w", "-t", window, "allow-rename", "off")

    tmux("source-file", str(config))

    if new:
        tmux("select-window", "-t", "{}1".format(TARGET))


def ensure_locked():
    """Run ensure_session while holding the launcher lock."""
    lock = lock_path()
    lock.parent.mkdir(parents=True, exist_ok=True)
    with open(str(lock), "w") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            ensure_session()
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def attach():
    if os.environ.get("TMUX"):
        tmux("switch-client", "-t", TARGET)
        return
    os.execvp(TMUX, [TMUX, "attach-session", "-t", TARGET])


def focus_next_attention():
    """Select the next window whose chat needs attention, wrapping around."""
    _require_managed()
    listing = tmux(
        "list-windows", "-t", TARGET, "-F",
        "#{window_index}|#{window_active}|#{E:@hand-status-state}",
    )
    current = None
    states = {}
    for line in listing.splitlines():
        index, active, state = line.split("|", 2)
        states[int(index)] = state
        if active == "1":
            current = int(index)
    for tier in ATTENTION_TIERS:
        candidates = sorted(
            index for index, state in states.items()
            if state == tier and 1 <= index <= 10 and index != current
        )
        if candidates:
            later = [index for index in candidates if current is not None and index > current]
            chosen = later[0] if later else candidates[0]
            tmux("select-window", "-t", "{}{}".format(TARGET, chosen))
            return
    tmux("display-message", "-t", TARGET, "No other chats need attention")


def _is_regular(path):
    try:
        return stat.S_ISREG(os.lstat(str(path)).st_mode)
    except OSError:
        return False


def _markdown_candidates(folder):
    yield folder / "plan.md"
    for subtree in ("files", "research", "checkpoints"):
        base = folder / subtree
        if base.is_symlink() or not base.is_dir():
            continue
        for directory, dirnames, filenames in os.walk(str(base)):
            dirnames.sort()
            for filename in sorted(filenames):
                if filename.endswith(".md"):
                    yield Path(directory) / filename


def newest_markdown(folder):
    """Return the newest candidate document in a session folder, or None."""
    best = None
    best_mtime = None
    for candidate in _markdown_candidates(Path(folder)):
        if not _is_regular(candidate):
            continue
        mtime = os.lstat(str(candidate)).st_mtime
        if best is None or mtime > best_mtime:
            best, best_mtime = candidate, mtime
    return best


def viewer_path():
    return Path(os.path.realpath(__file__)).parent / "md-view"


def show_markdown(pane, client=None):
    """Open the newest Markdown of the chat in ``pane`` with md-view."""
    _require_managed()
    session, _, folder = tmux(
        "display-message", "-p", "-t", pane, "#{session_name}\t#{@env-session-dir}"
    ).partition("\t")
    if session != SESSION:
        raise LauncherError("pane {} is not in the ai-agents session".format(pane))

    def message(text):
        args = ["display-message", "-l"]
        if client:
            args += ["-c", client]
        tmux(*args, text)

    if not folder or not os.path.isabs(folder) or not os.path.isdir(folder):
        message("No Copilot session folder for this chat")
        return
    document = newest_markdown(folder)
    if document is None:
        message("No Markdown in this chat's session folder yet")
        return
    try:
        result = subprocess.run(
            [str(viewer_path()), str(document)],
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
        )
    except OSError as error:
        message("md-view failed: {}".format(error))
        return
    if result.returncode != 0:
        lines = result.stderr.strip().splitlines()
        message(lines[-1] if lines else "md-view failed")


# --- restarting chats ------------------------------------------------------

SHELL_COMMANDS = ("fish", "zsh", "bash", "sh", "dash", "ksh")
RESTARTABLE_STATES = ("READY", "YOUR TURN")
_SESSION_ID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
_SGR = re.compile(r"\x1b\[[0-9;:?]*m")
# Dim text (Claude Code's composer placeholder), up to the attribute reset.
_DIM = re.compile(r"\x1b\[2m.*?(?:\x1b\[(?:0|22)?m|$)")
_RULE = re.compile(r"\s*─{8,}.*")
_PROMPTS = ("❯", "›", ">")


class Skipped(Exception):
    """A chat that is left alone, with the reason."""


def composer_state(screen):
    """Classify Claude Code's composer in a ``capture-pane -e`` dump.

    Returns ``"empty"`` when the box between the last two horizontal rules
    holds only the prompt (and dim placeholder text), ``"text"`` when it
    holds a draft, and ``"unknown"`` when no composer box is visible.
    """
    lines = [line for line in screen.splitlines() if line.strip()]
    rules = [i for i, line in enumerate(lines) if _RULE.fullmatch(_SGR.sub("", line))]
    if len(rules) < 2 or rules[-1] - rules[-2] < 2:
        return "unknown"
    body = lines[rules[-2] + 1:rules[-1]]
    text = " ".join(_SGR.sub("", _DIM.sub("", line)).strip() for line in body).strip()
    for prompt in _PROMPTS:
        if text.startswith(prompt):
            text = text[len(prompt):].strip()
            break
    else:
        return "unknown"
    return "empty" if not text else "text"


def resolve_environments(names):
    """Map user-given names (``left-ring``, ``left_ring``, ``Left Ring``) to windows."""
    if not names:
        return list(WINDOWS)
    by_key = {window[1]: window for window in WINDOWS}
    chosen = []
    for name in names:
        key = re.sub(r"[\s-]+", "_", name.strip().lower())
        if key not in by_key:
            raise LauncherError(
                "unknown environment {!r}; use one of: {}".format(
                    name, ", ".join(d.replace("_", "-") for d in _DIRECTORIES)
                )
            )
        if by_key[key] not in chosen:
            chosen.append(by_key[key])
    return sorted(chosen)


def _ancestor_pids():
    """This process and its ancestors, so the launcher never restarts its own chat."""
    pids = set()
    pid = os.getpid()
    while pid > 1 and pid not in pids:
        pids.add(pid)
        result = subprocess.run(
            ["ps", "-o", "ppid=", "-p", str(pid)],
            stdin=subprocess.DEVNULL, capture_output=True, text=True,
        )
        try:
            pid = int(result.stdout.strip())
        except ValueError:
            break
    return pids


def _memory_free_percent():
    try:
        result = subprocess.run(
            ["memory_pressure"], stdin=subprocess.DEVNULL, capture_output=True, text=True,
        )
    except OSError:
        return None
    match = re.search(r"free percentage:\s*(\d+)%", result.stdout)
    return int(match.group(1)) if match else None


def default_resource_check():
    """Enough free memory (30% or more) and a one-minute load below the core count."""
    free = _memory_free_percent()
    if free is not None and free < 30:
        return False, "memory {}% free".format(free)
    load = os.getloadavg()[0]
    cores = os.cpu_count() or 1
    if load >= cores:
        return False, "load {:.1f} on {} cores".format(load, cores)
    return True, ""


def claude_projects():
    base = Path(CLAUDE_CONFIG_DIR) if CLAUDE_CONFIG_DIR else Path(HOME) / ".claude"
    return base / "projects"


def has_conversation(folder):
    """True when Claude Code has a saved conversation for ``folder``."""
    slug = re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(folder))
    directory = claude_projects() / slug
    return directory.is_dir() and any(directory.glob("*.jsonl"))


def _pane_command(pane):
    return tmux("display-message", "-p", "-t", pane, "#{pane_current_command}")


def _wait_for(pane, predicate, timeout):
    deadline = time.monotonic() + timeout
    while True:
        command = _pane_command(pane)
        if predicate(command):
            return command
        if time.monotonic() > deadline:
            return None
        time.sleep(POLL)


def _check_restartable(pane_pid, command, state, owner, dead, own):
    if dead == "1":
        raise Skipped("pane is dead")
    if int(pane_pid) in own:
        raise Skipped("this is the chat running the restart")
    if command in SHELL_COMMANDS:
        raise Skipped("no chat running")
    if command == "copilot":
        raise Skipped("Copilot CLI chat; only Claude Code chats are restarted")
    if not _SESSION_ID.fullmatch(owner):
        raise Skipped("not a Claude Code chat ({})".format(command))
    if state not in RESTARTABLE_STATES:
        raise Skipped("busy ({})".format(state or "no state"))


def restart_chat(pane, shell):
    """Exit the chat in ``pane``, reload the login shell and start a chat again."""
    tmux("send-keys", "-t", pane, "-l", "/exit")
    time.sleep(KEY_PAUSE)
    tmux("send-keys", "-t", pane, "Enter")
    if _wait_for(pane, lambda c: c in SHELL_COMMANDS, EXIT_TIMEOUT) is None:
        raise LauncherError("the chat did not exit within {:g}s".format(EXIT_TIMEOUT))
    folder = tmux("display-message", "-p", "-t", pane, "#{pane_current_path}")
    tmux("send-keys", "-t", pane, "-l", "exec /usr/bin/env -u VIRTUAL_ENV {} -l".format(shell))
    tmux("send-keys", "-t", pane, "Enter")
    time.sleep(SHELL_PAUSE)
    if _wait_for(pane, lambda c: c in SHELL_COMMANDS, EXIT_TIMEOUT) is None:
        raise LauncherError("the login shell did not start within {:g}s".format(EXIT_TIMEOUT))
    resume = has_conversation(folder)
    tmux("send-keys", "-t", pane, "-l", CHAT_COMMAND + (" --continue" if resume else ""))
    tmux("send-keys", "-t", pane, "Enter")
    if _wait_for(pane, lambda c: c not in SHELL_COMMANDS, START_TIMEOUT) is None:
        raise LauncherError("no chat started within {:g}s".format(START_TIMEOUT))
    time.sleep(CONFIRM)
    if _pane_command(pane) in SHELL_COMMANDS:
        raise LauncherError("the new chat exited straight away; see the pane")
    return "restarted, continuing its conversation" if resume else "restarted, new conversation"


def restart_chats(names):
    """Restart idle Claude Code chats one at a time; return the number of failures."""
    _require_managed()
    windows = resolve_environments(names)
    shell = environment_shell()
    if not shell:
        raise LauncherError(
            "A login shell is required to restart chats; install fish or set SHELL"
        )
    own = _ancestor_pids()
    check = RESOURCE_CHECK or default_resource_check
    failures = 0
    restarted = False
    for index, _directory, name in windows:
        window = "{}{}".format(TARGET, index)
        try:
            fields = tmux(
                "display-message", "-p", "-t", window,
                "#{pane_id}\t#{pane_pid}\t#{pane_current_command}\t"
                "#{@env-copilot-state}\t#{@env-dashboard-owner}\t#{pane_dead}",
            ).split("\t")
        except LauncherError as error:
            print("{}: skipped, {}".format(name, error))
            continue
        pane, pane_pid, command, state, owner, dead = fields
        try:
            _check_restartable(pane_pid, command, state, owner, dead, own)
            screen = tmux("capture-pane", "-p", "-e", "-t", pane)
            if "esc to interrupt" in _SGR.sub("", screen):
                raise Skipped("busy (the chat shows esc to interrupt)")
            if composer_state(screen) != "empty":
                raise Skipped("the composer is not empty (a draft, or no composer visible)")
            if restarted and SETTLE:
                time.sleep(SETTLE)
            ok, detail = check()
            if not ok:
                raise Skipped("resources busy: {}".format(detail))
        except Skipped as reason:
            print("{}: skipped, {}".format(name, reason))
            continue
        try:
            outcome = restart_chat(pane, shell)
        except LauncherError as error:
            print("{}: failed, {}".format(name, error))
            failures += 1
            continue
        restarted = True
        print("{}: {}".format(name, outcome))
    return failures


def _parse(argv):
    parser = argparse.ArgumentParser(
        prog="ai-agents",
        description="Start or reattach the ai-agents tmux workbench of ten environment windows.",
    )
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--no-attach", action="store_true", help="prepare the session without attaching")
    modes.add_argument("--next-attention", action="store_true", help="select the next chat needing attention")
    modes.add_argument("--markdown", metavar="PANE", help="open the newest session Markdown of a tmux pane")
    modes.add_argument(
        "--restart", nargs="*", metavar="ENV",
        help="restart idle Claude Code chats (all, or the named environments, e.g. left-ring)",
    )
    parser.add_argument("--client", help=argparse.SUPPRESS)
    return parser.parse_args(argv)


def main(argv=None):
    args = _parse(argv)
    try:
        if args.next_attention:
            focus_next_attention()
        elif args.markdown is not None:
            show_markdown(args.markdown, args.client)
        elif args.restart is not None:
            return 1 if restart_chats(args.restart) else 0
        else:
            ensure_locked()
            if args.no_attach:
                print("Ready: {}".format(SESSION))
            else:
                attach()
    except (LauncherError, OSError) as error:
        print("ai-agents: {}".format(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
